[
  {
    "name": "matomo_visit_summary",
    "description": "Return Matomo visits, unique visitors, actions, bounce rate, visit duration, and conversions for a site and period. Answers how traffic volume and engagement changed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_apiKey": {
          "type": "string",
          "description": "Matomo read-only auth token"
        },
        "_baseUrl": {
          "type": "string",
          "description": "HTTPS Matomo installation URL, such as https://example.matomo.cloud/"
        },
        "site_id": {
          "type": "number",
          "description": "Matomo website ID"
        },
        "period": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month",
            "year",
            "range"
          ]
        },
        "date": {
          "type": "string",
          "description": "Date, relative date, or range such as 2026-07-01,2026-07-31"
        },
        "segment": {
          "type": "string",
          "description": "Optional Matomo segment expression"
        }
      },
      "required": [
        "_apiKey",
        "_baseUrl",
        "site_id",
        "period",
        "date"
      ]
    }
  },
